{
  "name": "siyuan-plugin-caldav-sync",
  "version": "0.1.5",
  "description": "Two-way sync calendar events and todos with CalDAV servers (Radicale / Nextcloud / Baikal). Month/Week/Day calendar views, task view, editor and daily note integration.",
  "repository": "https://github.com/bonebearHsu/siyuan-plugin-caldav-sync",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode dev",
    "build": "vite build && node scripts/make-package.mjs",
    "test": "npm run test:core && npm run test:loader",
    "test:loader": "node test/loader.test.mjs",
    "test:ui": "node test/ui.test.mjs",
    "test:core": "node test/core.test.mjs",
    "test:e2e": "node test/e2e.test.mjs",
    "e2e:radicale": "node scripts/radicale.mjs"
  },
  "keywords": [
    "siyuan",
    "plugin",
    "caldav",
    "radicale",
    "calendar",
    "tasks"
  ],
  "author": "bonebearHsu",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "jsdom": "^30.0.1",
    "jszip": "^3.10.1",
    "siyuan": "^1.2.7",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
